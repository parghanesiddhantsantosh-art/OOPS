}
#BreadthFirstSearch(BFS)usingadjacencylist def
bfs_list(start):
visited=set()
queue=deque([start])
result = []
whilequeue:
node=queue.popleft() if
node not in visited:
visited.add(node)
result.append(node)
forneighbor in adj_list[node]:
if neighbor not in visited:
queue.append(neighbor)
returnresult
