#DepthFirstSearch(DFS)usingadjacencymatrix def
dfs_matrix(start):
visited=[False]*len(locations)
result = []
def dfs(node):
visited[node]=True
result.append(locations[node])
forneighbor in range(len(adj_matrix)):
ifadj_matrix[node][neighbor]==1andnotvisited[neighbor]:
dfs(neighbor)
dfs(location_index[start])
return result
